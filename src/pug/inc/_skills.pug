h2.heading__second--section What I do
.skills__skillset 
  h3.skills__skillset-title Focusing on UI/UX Design,</br>handling Front End Development.
    ul.skills__skillset-list
      -
        const skills = [
          {
            img: "star-lightbulb",
            title: "Requirement Definition",
            icons: [],
          },
          {
            img: "magnifier-search-account",
            title: "UX Research",
            icons: ["icons8-figma","icons8-adobe-xd"],
          },
              {
            img: "website",
            title: "UI Design",
            icons: ["icons8-figma","icons8-adobe-xd","icons8-illustrator-52"],
          },
          {
            img: "programming",
            title: "Front End Development",
            icons: ["icons8-html-5","icons8-css3","icons8-sass","icons8-javascript","icons8-vuejs","icons8-vuetify"],
          },
        ]
      each skill in skills
        li.skills__skillset-list-item
          img(src=`./img/${skill.img}.svg`).skills__skillset-list-item-content--img
          .skills__skillset-list-item-content--title=skill.title
          ul.skills__skillset-icon-list
            each icon in skill.icons
              li.skills__skillset-icon-list-item
                img.skills__skillset-icon(src=`./img/${icon}.svg`)
.skills__statement 
  h3.skills__statement-title Clarify the Problem,</br>Integrate the Team.
  .skills__statement-text 
    p.skills__statement-text-paragraph With extensive knowledge and experience spanning design to coding, I approach problems holistically, considering not only the design perspective but also the implementation of development and the genuine needs of clients.
    p.skills__statement-text-paragraph Through effective communication with clients, marketers, and both Front End and Back End engineers, I create comprehensive documents tailored to each role, breaking down information as needed.
    p.skills__statement-text-paragraph This approach fosters team integration and enhances their collective understanding of the product. I firmly believe that such integration leads to a more sophisticated and reasoned product, as each team member can contribute ideas and opinions from their specialized perspective.